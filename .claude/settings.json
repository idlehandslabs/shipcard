{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(npm publish *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "dontAsk",
    "blockReadsOutsideWorkingDirectories": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
